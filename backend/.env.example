# Copy this file to .env inside backend/ and fill in your values.
# Paste your own Gemini API key after the equals sign. Do not commit or share it.
GEMINI_API_KEY=

# Load extension/ at chrome://extensions, then copy its 32-character ID here.
EXTENSION_ID=

# Change to 1 only after checking that the key's project has no billing attached.
GEMINI_UNBILLED_PROJECT_CONFIRMED=0
